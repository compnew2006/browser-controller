# Browser Controller — environment variables.
#
# Copy this file to `.env` and adjust as needed. The daemon is launched by the
# thin MCP client (see mcp-server/src/index.ts), so the environment that spawns
# `npx real-browser-mcp` is what matters — set these in your shell, your IDE's
# MCP config, or a `.env` loaded before the client starts.
#
# Nothing here is required. All values have working defaults.

# --- Network -------------------------------------------------------------

# Port the daemon's WebSocket + HTTP server binds on. The extension connects
# here. Override only if something else owns 7225 on your machine.
# WS_PORT=7225

# Interface to bind. 127.0.0.1 keeps the daemon loopback-only (recommended);
# do NOT set 0.0.0.0 unless you understand the exposure.
# WS_HOST=127.0.0.1

# --- Daemon state --------------------------------------------------------

# Where runtime state lives: token.json, daemon.json, daemon.sock, daemon.log.
# Override for isolated test runs (the test suite sets this itself).
# BC_STATE_DIR=~/.browser-controller

# IPC client heartbeat. An IDE killed without a graceful FIN is detected and
# evicted after this many missed pongs (interval × max).
# BC_HEARTBEAT_MS=15000
# BC_HEARTBEAT_MAX_MISSED=3

# Per-session tool-call budget over a rolling 60s window. Protects the browser
# from a runaway agent (infinite click/type loop). 120/min = 2 calls/sec,
# generous for normal use, stops runaway loops. Set to 0 to disable.
# BC_RATE_LIMIT_PER_MIN=120

# --- Agent identity & tool disclosure -----------------------------------

# Override the human-readable agent name shown in the popup (e.g. "Cursor",
# "Claude"). Auto-detected from IDE env vars otherwise; this wins over that.
# MCP_AGENT_NAME=
# BROWSER_CONTROLLER_AGENT_NAME=

# Progressive tool disclosure: expose only `browser_tools` initially (≈150
# tokens) instead of the full 22-tool manifest (≈4200 tokens). Set to 1 for
# tight context windows.
# BROWSER_CONTROLLER_PROGRESSIVE=0
