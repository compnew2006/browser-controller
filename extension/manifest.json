{
  "manifest_version": 3,
  "name": "Browser Controller",
  "version": "3.5.0",
  "description": "Let AI agents control your real browser - your tabs, your sessions, your logins",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "webRequest",
    "webNavigation",
    "storage",
    "alarms",
    "nativeMessaging",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:7225/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Browser Controller panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  }
}
