{
  "name": "browser-controller",
  "mcpName": "io.github.noiemany/browser-controller",
  "version": "3.3.0",
  "description": "MCP server + Chrome extension that gives AI agents control of your real browser with existing sessions and logins",
  "type": "module",
  "bin": {
    "browser-controller": "mcp-server/dist/index.js"
  },
  "main": "mcp-server/dist/index.js",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p mcp-server/tsconfig.json && npm run tools:gen && tsc -p mcp-server/tsconfig.json",
    "tools:gen": "node scripts/generate-tool-names.mjs --out mcp-server/src/protocol/tool-names.ts && node scripts/generate-extension-contract.mjs",
    "dev": "tsc -p mcp-server/tsconfig.json --watch",
    "start": "node mcp-server/dist/index.js",
    "daemon:start": "node scripts/daemon.mjs start",
    "daemon:stop": "node scripts/daemon.mjs stop",
    "daemon:restart": "node scripts/daemon.mjs restart",
    "daemon:status": "node scripts/daemon.mjs status",
    "daemon:health": "node scripts/daemon.mjs health",
    "memory": "node scripts/memory.mjs",
    "pretest": "node scripts/check-build.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/check-build.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:real-chrome": "node scripts/smoke-real-chrome.mjs",
    "smoke:vault-isolated": "node scripts/smoke-vault-isolated.mjs",
    "smoke:ci": "node scripts/smoke-vault-isolated.mjs --roundtrip-only",
    "smoke:vault-card": "node scripts/smoke-vault-card.mjs",
    "lint": "eslint mcp-server/src tests extension vitest.config.ts eslint.config.js",
    "arch:check": "vitest run tests/architecture.test.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/check-release.mjs",
    "typecheck": "tsc -p mcp-server/tsconfig.json --noEmit",
    "setup:cursor": "node agent-config/setup.mjs cursor",
    "setup:claude": "node agent-config/setup.mjs claude",
    "setup:pairing": "node scripts/pairing.mjs install",
    "pairing:status": "node scripts/pairing.mjs status",
    "pairing:rotate": "node scripts/pairing.mjs rotate",
    "pairing:uninstall": "node scripts/pairing.mjs uninstall",
    "context:lint": "ai-context-kit lint",
    "context:measure": "ai-context-kit measure"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "browser",
    "browser-automation",
    "browser-control",
    "browser-use",
    "chrome",
    "chrome-extension",
    "web-automation",
    "browser-controller",
    "live-browser",
    "model-context-protocol",
    "ai-agent",
    "ai-coding",
    "cursor",
    "claude",
    "windsurf",
    "playwright-alternative",
    "devtools"
  ],
  "author": "noiemany",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compnew2006/browser-controller.git"
  },
  "homepage": "https://github.com/compnew2006/browser-controller",
  "bugs": {
    "url": "https://github.com/compnew2006/browser-controller/issues"
  },
  "files": [
    "mcp-server/dist/",
    "extension/",
    "agent-config/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "ai-context-kit": "^0.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.14.0",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
