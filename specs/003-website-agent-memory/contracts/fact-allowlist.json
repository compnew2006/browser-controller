{
  "$comment": "Owner gate 3. Draft allowlist for website memory facts and the anonymity check. Every stored string must equal an entry here after normalization (NFKC, lower case, whitespace collapsed to one space, trimmed, trailing . : … removed). Changing this file changes what can be stored: review it like a permission change. Version it with the contract. v2 (2026-10-28): owner-requested widening; additions chosen from a names-only survey of public sites; the owner may trim any entry. v3 (2026-10-31): the form shape facts of specs/007-form-shape-facts — the kind ui.form.shape, the field types, the commit modes, the failure codes and their limits. The shape holds counts and vocabulary words only: no label, no name, no value, no placeholder, no id, no selector.",
  "version": 3,
  "factKinds": {
    "site.language": {
      "source": "siteContext.lang and siteContext.dir",
      "values": "lang: primaryLanguageTags; dir: ltr | rtl | null"
    },
    "ui.search": {
      "source": "snapshot line '<role> \"<name>\"' with role in searchRoles and name in phrases.search, or name starting with a searchPrefixes prefix (then the stored name is that prefix's canonical phrase, never the page's name)"
    },
    "ui.login": {
      "source": "siteContext.passwordField === true",
      "values": "path: page path if every segment is in pathSegments, else null"
    },
    "ui.control": {
      "source": "snapshot line '<role> \"<name>\"' with role in controlRoles and name in any phrases group except search"
    },
    "ui.form.shape": {
      "source": "siteContext.formShape for the form inside the main landmark; the commit mode is added by the daemon from an observed write on that path and applied at the next observed read of that path",
      "values": "shape: fields, required, types (each from fieldTypes, each at most once), hidden; commit: from commitModes",
      "identity": "ui.form.shape:<path> - the path is kept only when every segment is in pathSegments; the root path '/' is kept as well, because it names no topic"
    }
  },
