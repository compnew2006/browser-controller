  "anonymityNames": {
    "$comment": "Cookie and web-storage key NAMES that do not by themselves indicate a signed-in user (consent and first-party analytics). Exact names or a full-match pattern (a bare prefix such as _ga_ is not enough: a site could name a session cookie _ga_session). Any other name makes the page unverified (anonymous:false). Values are never read.",
    "exact": [
      "CookieConsent",
      "OptanonConsent",
      "OptanonAlertBoxClosed",
      "euconsent-v2",
      "cookieyes-consent",
      "cookielawinfo-checkbox-necessary",
      "_ga",
      "_gid",
      "_gat",
      "_gcl_au",
      "_fbp",
      "cookies_policy",
      "FCCDCF",
      "FCNEC",
      "GeoIP",
      "NetworkProbeLimit",
