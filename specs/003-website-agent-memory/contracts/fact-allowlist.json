      "WMF-Last-Access-Global",
      "WMF-Uniq",
      "WMF-DP",
      "appLifetimeMetrics",
      "userLifetimeMetrics",
      "glean_session_last_active",
      "__cf_bm",
      "_cfuvid",
      "cf_clearance",
      "AWSALB",
      "AWSALBCORS",
      "_clck",
      "_clsk",
      "CentralAuthAnon",
      "ddg-promotions"
    ],
